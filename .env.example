# ===== Smart Kost — contoh environment =====
# Salin ke .env.local untuk development, dan isi di Vercel > Project Settings > Environment Variables.

# --- Google Apps Script (FUP, reset, wajah) ---
NEXT_PUBLIC_GOOGLE_SCRIPT_URL=

# --- Groq AI (chat & suara) ---
VITE_GROQ_API_KEY=

# --- MikroTik API via Tunnel VPN (server-side / JANGAN pakai prefix VITE_) ---
# MIKROTIK_USER/PASS = user RouterOS dengan policy "api" (bukan akun tunnel).
# Port API 8728 dipetakan ke port publik tunnel (contoh: 32179).
MIKROTIK_HOST=remote5.vpnmurahjogja.my.id
MIKROTIK_PORT=32179
MIKROTIK_USER=
MIKROTIK_PASS=
# Hanya ambil user hotspot dengan profile ini (kosongkan untuk semua profile)
MIKROTIK_HOTSPOT_PROFILE=KOST-50
# Password konfirmasi untuk aksi disable/enable user hotspot dari dashboard
MIKROTIK_ADMIN_PASSWORD=

# --- Pengaturan sumber data realtime (client) ---
# tunnel = realtime via VPN | sheets = Google Sheets (cadangan)
VITE_DATA_MODE=tunnel
# Interval polling ke router (milidetik)
VITE_POLL_INTERVAL_MS=30000
# Interval polling metrik monitoring perangkat (CPU, trafik, dsb.)
VITE_STATS_POLL_MS=5000
# Interval muat ulang data spreadsheet untuk grafik bandwidth
VITE_SHEET_REFRESH_MS=300000
# Timeout koneksi API MikroTik (milidetik)
VITE_MIKROTIK_TIMEOUT_MS=30000
# Webfig MikroTik via tunnel (tombol "MikroTik Webfig" di dashboard)
VITE_WEBFIG_URL=http://remote5.vpnmurahjogja.my.id:12179/
# Override base URL API (opsional, default /api/mikrotik)
# VITE_MIKROTIK_API=/api/mikrotik
